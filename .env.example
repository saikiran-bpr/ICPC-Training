# Backend (FastAPI) environment variables.
# Copy to .env for local dev (git-ignored); set these in the Render dashboard
# for production.

# --- Required ---------------------------------------------------------------
# Supabase Postgres connection string. In production prefer the transaction
# pooler host (…pooler.supabase.com:6543) — the pool already disables named
# prepared statements so it's pooler-safe.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Fixed random hex used to sign session cookies. Generate once:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT regenerate per deploy — it invalidates every existing session.
FLASK_SECRET_KEY=

# --- Production (set on Render) ---------------------------------------------
# Exact frontend origin(s), no trailing slash. Comma-separated or JSON array.
#   CORS_ORIGINS=https://icpc-web.onrender.com
CORS_ORIGINS=

# Cross-site cookie flags. For a separate frontend domain BOTH are required:
COOKIE_SECURE=true
COOKIE_SAMESITE=none

DEBUG=false

# --- Optional (have sane defaults) ------------------------------------------
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# SESSION_COOKIE_NAME=session
# SESSION_LIFETIME_DAYS=14
