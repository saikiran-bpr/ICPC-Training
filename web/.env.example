# Base URL of the FastAPI backend.
#
# Vite inlines VITE_* variables at BUILD time — this must be set in the build
# environment (Render static-site env var), not at runtime.
#
# Dev:  leave empty to use the Vite proxy (/api -> http://127.0.0.1:8000).
# Prod: set to the deployed API origin, e.g. https://icpc-api.onrender.com
VITE_API_BASE_URL=
